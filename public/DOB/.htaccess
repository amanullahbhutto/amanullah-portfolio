# Prevent execution of any scripts in the uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|pht|phar|sh|pl|cgi|asp|aspx|exe|bat|cmd|vbs)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -ExecCGI -Indexes
